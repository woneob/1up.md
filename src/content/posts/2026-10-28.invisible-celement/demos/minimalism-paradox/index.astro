---
// 본문 인라인 차트(정적 SVG). 화면 단순화 수준에 따른 두 지표의 교차를 표현.
// 상승: 인지 부하·작업 시간 / 하강: 기능 발견 가능성.
---

<svg viewBox="0 0 680 400" class="diagram-chart">
  <text x="340" y="36" class="diagram-title">화면 단순화에 따른 사용성 지표 교차 변화</text>

  <g class="diagram-grid">
    <line x1="50" y1="110" x2="630" y2="110" />
    <line x1="50" y1="160" x2="630" y2="160" />
    <line x1="50" y1="210" x2="630" y2="210" />
    <line x1="50" y1="260" x2="630" y2="260" />
  </g>

  <line x1="50" y1="310" x2="630" y2="310" class="diagram-axis" />
  <line x1="50" y1="70" x2="50" y2="310" class="diagram-axis" />

  <text x="432" y="118" class="y-axis-label left">인지 부하 및 작업 시간</text>
  <text x="530" y="250" class="y-axis-label right">기능 발견 가능성</text>

  <text x="340" y="334" class="diagram-label center">화면 단순화 수준 (요소 감춤 정도) →</text>
  <text x="50" y="332" class="diagram-sublabel left">낮음 (요소 노출)</text>
  <text x="630" y="332" class="diagram-sublabel right">높음 (요소 은폐)</text>

  <g class="line-group effort">
    <path d="M 50 280 Q 340 260 630 90" class="line-effort" />
    <circle cx="50" cy="280" r="5" class="point-effort" />
    <circle cx="630" cy="90" r="5" class="point-effort" />
  </g>

  <g class="line-group discoverability">
    <path d="M 50 90 Q 340 110 630 280" class="line-discoverability" />
    <circle cx="50" cy="90" r="5" class="point-discoverability" />
    <circle cx="630" cy="280" r="5" class="point-discoverability" />
  </g>

  <g class="diagram-legend" transform="translate(190, 385)">
    <g class="legend-item effort">
      <line x1="0" y1="0" x2="20" y2="0" class="line-effort" />
      <circle cx="10" cy="0" r="3.5" class="point-effort" />
      <text x="28" y="4" class="legend-text">인지 부하 및 작업 시간</text>
    </g>
    <g class="legend-item discoverability" transform="translate(170, 0)">
      <line x1="0" y1="0" x2="20" y2="0" class="line-discoverability" />
      <circle cx="10" cy="0" r="3.5" class="point-discoverability" />
      <text x="28" y="4" class="legend-text">기능 발견 가능성</text>
    </g>
  </g>
</svg>

<style lang="scss">
 .diagram-chart {
  width: 100%;
  max-width: 760px;
  height: auto;
  background-color: #f7f7f7;
  border: 1px solid #eee;
  border-radius: 4px;
  padding: 16px;
  box-sizing: border-box;
}

.diagram-title {
  font-size: 16px;
  font-weight: 700;
  text-anchor: middle;
  letter-spacing: -0.02em;
}

.diagram-grid line {
  stroke: #f0f0f0;
  stroke-width: 1;
  stroke-dasharray: 2 2;
}

.diagram-axis {
  stroke: #111111;
  stroke-width: 1.2;
}

.y-axis-label {
  font-size: 13px;
  font-weight: 600;
}

.y-axis-label.left {
  fill: #d9383a;
  text-anchor: start;
}

.y-axis-label.right {
  fill: #2563eb;
  text-anchor: end;
}

.diagram-label {
  fill: #111111;
  font-size: 14px;
  font-weight: 600;
}

.diagram-sublabel {
  fill: #666666;
  font-size: 13px;
}

.center { text-anchor: middle; }
.left { text-anchor: start; }
.right { text-anchor: end; }

/* Line Styles */
.line-effort {
  fill: none;
  stroke: #d9383a;
  stroke-width: 2.2;
  transition: all 0.25s ease;
}

.point-effort {
  fill: #fff;
  stroke: #d9383a;
  stroke-width: 2;
  transition: all 0.25s ease;
}

.line-discoverability {
  fill: none;
  stroke: #2563eb;
  stroke-width: 2.2;
  stroke-dasharray: 5 4;
  transition: all 0.25s ease;
}

.point-discoverability {
  fill: #fff;
  stroke: #2563eb;
  stroke-width: 2;
  transition: all 0.25s ease;
}

.legend-text {
  fill: #333333;
  font-size: 13px;
  font-weight: 500;
}
</style>
