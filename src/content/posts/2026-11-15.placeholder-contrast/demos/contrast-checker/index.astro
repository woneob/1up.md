---
import { luminance, toRgb, contrast } from '../colors.js';

const initial = { background: '#FFFFFF', foreground: '#767676' };
const ratio = Math.floor(contrast(luminance(toRgb(initial.foreground)), luminance(toRgb(initial.background))) * 100) / 100;
const min = { AA: { normal: 4.5, large: 3 }, AAA: { normal: 7, large: 4.5 } };
const pickers = [
  { key: 'background', label: '배경색' },
  { key: 'foreground', label: '글자색' },
];
const options = [
  {
    key: 'level',
    label: '등급',
    items: [
      { value: 'AA', label: 'AA', desc: '최소 기준' },
      { value: 'AAA', label: 'AAA', desc: '강화 기준' },
    ],
  },
  {
    key: 'size',
    label: '텍스트 종류',
    items: [
      { value: 'normal', label: '본문 텍스트', desc: '큰 텍스트가 아닌 모든 텍스트' },
      { value: 'large', label: '큰 텍스트', desc: '18pt(24px) 이상, 또는 굵은 14pt(약 18.7px) 이상' },
    ],
  },
];
const pass = ratio >= min.AA.normal;
---

<div class="checker-demo" data-contrast-checker>
  <div class="controls">
    {pickers.map(({ key, label }) => (
      <div class="control">
        <label class="label" for={`cc-${key}`}>{label}</label>
        <div class="picker">
          <input type="color" data-picker={key} value={initial[key].toLowerCase()} aria-label={`${label} 선택`} />
          <input id={`cc-${key}`} data-text={key} type="text" value={initial[key]} maxlength="7" autocomplete="off" spellcheck="false" />
          <button type="button" class="copy" data-copy={key} aria-label={`${label} 복사`} title="복사">
            <svg class="i-copy" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
            <svg class="i-done" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
          </button>
        </div>
      </div>
    ))}
    {options.map(({ key, label, items }) => (
      <div class="control">
        <span class="label" id={`cc-${key}-label`}>{label}</span>
        <div class="seg" role="radiogroup" aria-labelledby={`cc-${key}-label`}>
          {items.map((item, i) => (
            <label>
              <input type="radio" name={`cc-${key}`} value={item.value} data-option={key} data-desc={item.desc} checked={i === 0} />
              <span class="pill">{item.label}</span>
            </label>
          ))}
        </div>
        <span class="desc" data-desc-of={key}>{items[0].desc}</span>
      </div>
    ))}
  </div>

  <div class="card">
    <div
      class="preview"
      data-preview
      data-size="normal"
      style={`--fg:${initial.foreground};--bg:${initial.background}`}
    >
      <div class="sample" contenteditable="plaintext-only" role="textbox" aria-label="미리보기 문구 (수정 가능)" spellcheck="false" data-max="60">일반 텍스트 샘플입니다. The quick brown fox jumps over the lazy dog.</div>
    </div>

    <div class="result row" data-pass={pass ? 'true' : 'false'} data-min-table={JSON.stringify(min)}>
      <div class="score">
        <span class="hint">명암비</span>
        <output data-out="ratio" aria-live="polite" aria-label="명암비">{ratio.toFixed(2)}:1</output>
      </div>
      <div class="verdict">
        <output class="badge" data-out="badge" aria-live="polite">{pass ? '통과' : '실패'}</output>
        <span class="hint" data-out="need">AA 기준 {min.AA.normal}:1 이상</span>
      </div>
    </div>

    <div class="suggest row" data-suggest hidden>
      <span class="hint">가장 가까운 통과 색상</span>
      <button type="button" class="apply" data-apply title="글자색에 적용">
        <i class="chip" aria-hidden="true"></i>
        <span class="hex" data-out="suggest-hex"></span>
        <span class="sub" data-out="suggest-ratio"></span>
        <span class="cta">적용하기</span>
      </button>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../demo-ui' as *;

  .checker-demo {
    @include demo-ui;

    .preview {
      padding: rem(24) rem(16);
      background: var(--bg);
      color: var(--fg);
      .sample {
        min-block-size: 1.3em;
        margin: -2px -5px; // padding 만큼 상쇄해 가장자리 정렬 유지
        padding: 2px 5px;
        border-radius: 5px;
        font-size: rem(16);
        overflow-wrap: anywhere;
        &:focus-visible { outline: 1px dashed; outline-offset: 0.25rem; }
      }
      // 큰 텍스트: 24px 이상(또는 굵은 18.7px 이상)
      &[data-size='large'] .sample { font-size: rem(24); font-weight: 600; line-height: 1.3; }
    }

    .verdict {
      display: grid;
      justify-items: end;
      gap: rem(6);
    }
    .result {
      &[data-pass='true'] .badge { background: #e3f4e8; color: #14612b; }
      &[data-pass='false'] .badge { background: #fde8e6; color: #a1281d; }
    }

    .suggest {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: rem(8) rem(12);
      .chip { --c: var(--suggest); }
    }

    @media (forced-colors: active) {
      .preview { forced-color-adjust: none; }
    }
  }
</style>
<script>import './script.js';</script>
