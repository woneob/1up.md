---
import { MIN, ratio, solve } from './logic.js';

const initial = { background: '#FFFFFF', text: '#222222' };
const result = solve(initial.background, initial.text);
const pickers = [
  { key: 'background', label: '배경색' },
  { key: 'text', label: '입력 글자색' },
];
const tones = [
  { value: 'neutral', label: '무채색' },
  { value: 'tinted', label: '글자색 색조' },
];
const checks = [
  { key: 'background', label: '플레이스홀더 ↔ 배경', value: ratio(result.placeholder, initial.background) },
  { key: 'text', label: '플레이스홀더 ↔ 입력 글자', value: ratio(result.placeholder, initial.text) },
];
const ok = result.status === 'ok';
---

<div
  class="pair-demo"
  data-pair-checker
  data-status={result.status}
  style={`--bg:${initial.background};--fg:${initial.text};--ph:${result.placeholder}`}
>
  <div class="controls">
    {pickers.map(({ key, label }) => (
      <div class="control">
        <label class="label" for={`pc-${key}`}>{label}</label>
        <div class="picker">
          <input type="color" data-picker={key} value={initial[key].toLowerCase()} aria-label={`${label} 선택`} />
          <input id={`pc-${key}`} data-text={key} type="text" value={initial[key]} maxlength="7" autocomplete="off" spellcheck="false" />
          <button type="button" class="copy" data-copy={key} aria-label={`${label} 복사`} title="복사">
            <svg class="i-copy" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
            <svg class="i-done" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
          </button>
        </div>
      </div>
    ))}
    <div class="control">
      <span class="label" id="pc-tone-label">플레이스홀더 색조</span>
      <div class="seg" role="radiogroup" aria-labelledby="pc-tone-label">
        {tones.map(({ value, label }, i) => (
          <label>
            <input type="radio" name="pc-tone" value={value} checked={i === 0} />
            <span class="pill">{label}</span>
          </label>
        ))}
      </div>
    </div>
  </div>

  <div class="card">
    <div class="preview row">
      <label class="field">
        <span class="label">입력 전</span>
        <input type="text" placeholder="예: 홍길동" autocomplete="off" spellcheck="false" />
      </label>
      <label class="field">
        <span class="label">입력 후</span>
        <input type="text" value="홍길동" placeholder="예: 홍길동" autocomplete="off" spellcheck="false" />
      </label>
    </div>

    <div class="result row">
      <div class="score">
        <span class="hint" data-out="title">{ok ? '추천 플레이스홀더 색' : '기준에 맞는 플레이스홀더 색 없음'}</span>
        <div class="value">
          <i class="chip" aria-hidden="true"></i>
          <output class="hex" data-out="placeholder" aria-live="polite" aria-label="플레이스홀더 색">{result.placeholder}</output>
          <button type="button" class="copy" data-copy="placeholder" aria-label="플레이스홀더 색 복사" title="복사">
            <svg class="i-copy" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
            <svg class="i-done" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
          </button>
        </div>
      </div>
      <output class="badge" data-out="badge" aria-live="polite">{ok ? '통과' : '실패'}</output>
    </div>

    <div class="notice row" data-notice hidden={ok}>
      <div class="message" data-out="message"></div>
      <div class="pair" data-pair hidden={!result.pair}>
        <span class="hint">가장 가까운 통과 조합</span>
        <button type="button" class="apply" data-apply title="입력 글자색에 적용">
          <i class="chip" data-pair-chip="text" aria-hidden="true"></i>
          <span class="sub">입력 글자</span>
          <span class="hex" data-out="pair-text">{result.pair?.text}</span>
          <i class="chip" data-pair-chip="placeholder" aria-hidden="true"></i>
          <span class="sub">플레이스홀더</span>
          <span class="hex" data-out="pair-placeholder">{result.pair?.placeholder}</span>
          <span class="cta">적용하기</span>
        </button>
      </div>
    </div>

    <div class="checks row">
      {checks.map(({ key, label, value }) => (
        <div class="check" data-check={key} data-pass={value >= MIN[key] ? 'true' : 'false'}>
          <span class="name">{label} <span class="hint">({MIN[key]}:1 이상)</span></span>
          <span class="val" data-out={`ratio-${key}`}>{value.toFixed(2)}:1</span>
        </div>
      ))}
      <div class="check" data-range hidden={!result.range}>
        <span class="name">사용 가능 범위</span>
        <span class="val">
          <i class="chip" data-range-chip="0" style={`--c:${result.range?.[0] ?? ''}`} aria-hidden="true"></i>
          <span class="hex" data-out="range-0">{result.range?.[0]}</span>
          ~
          <i class="chip" data-range-chip="1" style={`--c:${result.range?.[1] ?? ''}`} aria-hidden="true"></i>
          <span class="hex" data-out="range-1">{result.range?.[1]}</span>
        </span>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../demo-ui' as *;

  .pair-demo {
    @include demo-ui;

    .preview {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: rem(12);
      padding-block: rem(16);
      background: #f5f5f5;
    }
    .field {
      display: grid;
      gap: rem(6);
      min-width: 0;
      input {
        inline-size: 100%;
        min-inline-size: 0;
        padding: rem(10) rem(12);
        border: 1px solid #c9ced6;
        border-radius: rem(8);
        background: var(--bg);
        color: var(--fg);
        font: inherit;
        font-size: rem(16);
        // 브라우저 기본 투명도 제거 → 계산한 색 그대로 표시
        &::placeholder { color: var(--ph); opacity: 1; }
        &:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      }
    }

    .value {
      display: flex;
      align-items: center;
      gap: rem(8);
      .chip { --c: var(--ph); inline-size: rem(28); block-size: rem(28); }
    }
    &[data-status='ok'] .badge { background: #e3f4e8; color: #14612b; }
    &:not([data-status='ok']) .badge { background: #fde8e6; color: #a1281d; }

    .checks {
      display: grid;
      gap: rem(8);
    }
    .check {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: rem(4) rem(12);
      .val {
        display: inline-flex;
        align-items: center;
        gap: rem(6);
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }
      .chip { inline-size: rem(18); block-size: rem(18); }
      // 판정은 색 + 기호로 표시(색만으로 구분하지 않음)
      &[data-pass='true'] .val { color: #14612b; &::after { content: '✓'; } }
      &[data-pass='false'] .val { color: #a1281d; &::after { content: '✕'; } }
    }

    .notice {
      display: grid;
      gap: rem(10);
      .message { color: #a1281d; font-size: rem(14); }
    }
    .pair {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: rem(8) rem(12);
    }
    .apply .hex + .chip { margin-inline-start: rem(6); }

    @media (forced-colors: active) {
      .field input { forced-color-adjust: none; }
    }
  }
</style>
<script>import './script.js';</script>
