---
// 마이크 아이콘. slash = 음소거 표시(사선). 장식용이라 aria-hidden 고정.
const { slash = false } = Astro.props;
---

<svg class="mic-icon" viewBox="0 0 24 24" aria-hidden="true">
  <rect x="9" y="3" width="6" height="11" rx="3"></rect>
  <path d={slash ? 'M5 11a7 7 0 0 0 14 0M12 18v3M4 3l16 18' : 'M5 11a7 7 0 0 0 14 0M12 18v3'}></path>
</svg>

<style lang="scss">
  .mic-icon {
    display: block;
    width: rem(22);
    height: rem(22);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
