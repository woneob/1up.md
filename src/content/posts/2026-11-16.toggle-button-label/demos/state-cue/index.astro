---
// 본문 인라인 데모(standalone 문서 아님). 2상태 버튼에서 버튼 밖 단서의 유무 비교.
// - play: 영상 움직임이 단서 → 버튼이 다음 동작만 표현해도 현재 상태 파악 가능
// - mic: 단서 없음 → 같은 규칙의 버튼인데 현재 상태 파악 불가. 옵션으로 상태 표시 추가
// 두 버튼 모두 "누르면 일어날 일"을 아이콘으로 표현(글머리 마이크 버튼과 동일 규칙).
// 초기 상태(정지·마이크 켜짐)를 SSR 로 확정(제로 CLS) → script.js 는 전환·옵션만 담당.
const columns = [
  {
    kind: 'play',
    on: false,
    tone: 'good',
    badge: '단서 있음',
    title: '재생 버튼',
    label: '재생하기',
    note: '영상이 움직이는지만 봐도 지금 상태를 안다.',
  },
  {
    kind: 'mic',
    on: true,
    tone: 'neutral',
    badge: '단서 없음',
    title: '음소거 버튼',
    label: '음소거하기',
    note: '버튼만으로는 마이크가 켜져 있는지 알 수 없다.',
  },
];
---

<div class="demo sc-demo">
  <div class="sc-options">
    <label class="sc-option">
      <input type="checkbox" data-option="cue" />
      <span>마이크 상태 표시 붙이기</span>
    </label>
  </div>

  <div class="sc-grid">
    {
      columns.map((col) => (
        <figure class="sc-col" data-kind={col.kind} data-on={String(col.on)}>
          <figcaption class="sc-head">
            <span class={`sc-badge sc-badge--${col.tone} sc-nocue`}>{col.badge}</span>
            {col.kind === "mic" && <span class="sc-badge sc-badge--good sc-withcue">단서 있음</span>}
            <span class="sc-title">{col.title}</span>
          </figcaption>

          <div class="sc-box">
            {col.kind === 'play' ? (
              <div class="sc-stage sc-video" aria-hidden="true">
                <span class="sc-layer sc-layer--stars" />
                <span class="sc-layer sc-layer--near" />
                <span class="sc-ground" />
                <span class="sc-layer sc-layer--lamps" />
                <span class="sc-layer sc-layer--lane" />
                <svg class="sc-car" viewBox="0 0 56 26">
                  <path class="sc-car-beam" d="M53.5 13 80 7v16z" />
                  <g class="sc-car-body">
                    <path
                      fill="#e5484d"
                      d="M3 18v-5q0-2 2-2.4l8-1.4 5-5.2q1.2-1.2 3-1.2h12q1.8 0 3 1l7 5.6 8 1.6q2.5.5 2.5 3V18q0 1.5-1.5 1.5H4.5Q3 19.5 3 18z"
                    />
                    <path fill="#a9cdee" d="M19.5 5.2 15.5 9.4h11V5.2zM28.5 5.2v4.2H40l-5.2-4.2z" />
                    <rect x="51" y="12" width="2.5" height="2.5" rx="0.6" fill="#ffe9a8" />
                    <rect x="3" y="12.5" width="2" height="2.5" rx="0.6" fill="#ffb3a6" />
                  </g>
                  {[14, 42].map((x) => (
                    <g transform={`translate(${x} 19.5)`}>
                      <g class="sc-wheel">
                        <circle r="5" fill="#0d101b" />
                        <circle r="2.4" fill="#9aa0ad" />
                        <path d="M-4.2 0h8.4M0-4.2v8.4" stroke="#9aa0ad" stroke-width="1" />
                      </g>
                    </g>
                  ))}
                </svg>
                <span class="sc-progress">
                  <span />
                </span>
              </div>
            ) : (
              <div class="sc-stage sc-meeting" aria-hidden="true">
                <span class="sc-tile sc-tile--me">
                  <span class="sc-avatar">나</span>
                  <span class="sc-cue">
                    <span class="sc-meter">
                      <span />
                      <span />
                      <span />
                    </span>
                    <span class="sc-cue-text sc-cue-text--on">마이크 켜짐</span>
                    <span class="sc-cue-text sc-cue-text--off">마이크 꺼짐</span>
                  </span>
                </span>
                <span class="sc-tile">
                  <span class="sc-avatar sc-avatar--a">김</span>
                </span>
                <span class="sc-tile">
                  <span class="sc-avatar sc-avatar--b">박</span>
                </span>
              </div>
            )}

            <div class="sc-bar">
              <button type="button" class="sc-btn" aria-label={col.label}>
                {col.kind === 'play' ? (
                  <>
                    <svg class="sc-icon sc-icon--off" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M8 5v14l11-7z" fill="currentColor" />
                    </svg>
                    <svg class="sc-icon sc-icon--on" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" />
                    </svg>
                  </>
                ) : (
                  <>
                    <svg class="sc-icon sc-icon--off sc-icon--line" viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="9" y="3" width="6" height="11" rx="3" />
                      <path d="M5 11a7 7 0 0 0 14 0M12 18v3" />
                    </svg>
                    <svg class="sc-icon sc-icon--on sc-icon--line" viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="9" y="3" width="6" height="11" rx="3" />
                      <path d="M5 11a7 7 0 0 0 14 0M12 18v3M4 3l16 18" />
                    </svg>
                  </>
                )}
              </button>
            </div>
          </div>

          <div class="sc-note sc-nocue">{col.note}</div>
          {col.kind === "mic" && (
            <div class="sc-note sc-withcue">같은 버튼인데, 상태 표시 덕분에 지금 상태를 안다.</div>
          )}
        </figure>
      ))
    }
  </div>
</div>

<style lang="scss">
  .sc-demo {
    padding: rem(24) rem(14) rem(28);
    background: #f9f9f9;
    border: 1px solid #e3e3e3;
    border-radius: rem(7);
    color: #3b3e49;
    font-size: 0.85rem;
    text-align: left;

    // 모바일 1열 — 옵션을 영상과 마이크 사이로 이동(.sc-grid 해제 후 order 재배치)
    @media (max-width: $bp-mobile) {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }

  .sc-options {
    display: flex;
    justify-content: center;
    margin-bottom: rem(20);
    font-size: 0.8rem;
    color: #555;

    @media (max-width: $bp-mobile) {
      order: 1;
      justify-content: flex-start;
      width: 100%;
      max-width: rem(320);
      margin-block: rem(20) rem(12);
      padding-top: rem(18);
      border-top: 1px solid #e3e3e3;
    }
  }

  .sc-option {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: rem(8) rem(14);
    border: 1px solid #b9cdf5;
    border-radius: rem(8);
    background: #fff;
    color: #222;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;

    &:hover {
      border-color: #3b82f6;
    }

    &:has(input:checked) {
      border-color: #3b82f6;
      background: #eef4ff;
      color: #1d4ed8;
    }

    &:has(input:focus-visible) {
      outline: 2px solid #3b82f6;
      outline-offset: 2px;
    }

    input {
      width: rem(16);
      height: rem(16);
      margin: 0;
      accent-color: #3b82f6;
    }
  }

  .sc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: rem(16);
    max-width: rem(520);
    margin-inline: auto;

    @media (max-width: $bp-mobile) {
      display: contents;
    }
  }

  .sc-col {
    margin: 0;
    min-width: 0;

    @media (max-width: $bp-mobile) {
      width: 100%;
      max-width: rem(320);

      &[data-kind='mic'] {
        order: 2;
      }
    }
  }

  .sc-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    font-size: 0.86rem;
  }

  .sc-title {
    font-weight: 600;
    color: #222;
  }

  .sc-badge {
    flex: none;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.5;

    &--good {
      color: #1e874b;
      background: #e9f7ef;
    }
    &--neutral {
      color: #5b6170;
      background: #eceef2;
    }
  }

  .sc-box {
    overflow: hidden;
    border: 1px solid #cfcfd4;
    border-radius: rem(8);
    background: #fff;
  }

  .sc-stage {
    position: relative;
    height: rem(120);
    overflow: hidden;
  }

  // 영상 — 밤길을 달리는 자동차. 자동차는 제자리, 배경 레이어가 왼쪽으로 흐름.
  // 먼 레이어일수록 느리게(산 < 가로등 < 차선) → 패럴렉스.
  // data-on 으로 재생/정지
  .sc-video {
    background: linear-gradient(#141b33, #2a3260 55%, #5b5486 72%);
  }

  // 타일 하나(--tile)만큼 더 넓게 깔고 그만큼 이동 → 이음매 없는 반복
  .sc-layer {
    position: absolute;
    left: 0;
    width: calc(100% + var(--tile));
    background-repeat: repeat-x;
    background-size: var(--tile) 100%;
    animation: sc-scroll var(--dur) linear infinite;
    animation-play-state: paused;

    &--stars {
      --tile: #{rem(260)};
      top: rem(6);
      width: 100%;
      animation: none; // 별은 고정
      height: rem(56);
      background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 260 56' fill='%23fff'><circle cx='14' cy='10' r='1' opacity='.8'/><circle cx='42' cy='30' r='.7' opacity='.5'/><circle cx='70' cy='8' r='.8' opacity='.7'/><circle cx='96' cy='22' r='1' opacity='.6'/><circle cx='120' cy='44' r='.6' opacity='.4'/><circle cx='138' cy='12' r='.7' opacity='.8'/><circle cx='166' cy='34' r='.9' opacity='.5'/><circle cx='190' cy='6' r='.7' opacity='.6'/><circle cx='214' cy='26' r='1' opacity='.7'/><circle cx='240' cy='16' r='.7' opacity='.5'/><circle cx='250' cy='42' r='.6' opacity='.4'/></svg>");
    }

    &--near {
      --tile: #{rem(180)};
      --dur: 12s;
      bottom: rem(34);
      height: rem(40);
      background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 40'><path fill='%23232949' d='M0 40V26l24-16 22 14L70 4l28 22 26-12 26 14 30-2v14z'/></svg>");
    }

    &--lamps {
      --tile: #{rem(150)};
      --dur: 1.8s;
      bottom: rem(34);
      height: rem(48);
      background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 150 48'><path fill='%23ffd98a' opacity='.14' d='M28 10 14 48h36L36 10z'/><path fill='%230c0f1c' d='M20 6h2v42h-2zM20 6h14v2H20z'/><rect x='27' y='8' width='10' height='2.5' rx='1' fill='%23ffd98a'/></svg>");
    }

    &--lane {
      --tile: #{rem(40)};
      --dur: 0.4s;
      bottom: rem(25);
      height: rem(2);
      background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.55) 45%, transparent 45%);
    }
  }

  .sc-ground {
    position: absolute;
    inset: auto 0 0;
    height: rem(34);
    border-top: 1px solid #3b4165;
    background: #1b1f30;
  }

  .sc-car {
    position: absolute;
    left: 28%;
    bottom: rem(17);
    width: rem(56);
    height: rem(26);
    overflow: visible;
  }

  .sc-car-beam {
    fill: #ffe9a8;
    opacity: 0.2;
  }

  .sc-car-body {
    animation: sc-bounce 0.28s ease-in-out infinite alternate;
    animation-play-state: paused;
  }

  .sc-wheel {
    transform-box: fill-box;
    transform-origin: center;
    animation: sc-spin 0.35s linear infinite;
    animation-play-state: paused;
  }

  .sc-progress {
    position: absolute;
    inset: auto rem(12) rem(8);
    height: rem(4);
    border-radius: rem(2);
    background: rgba(255, 255, 255, 0.25);

    span {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: inherit;
      background: #fff;
      transform-origin: left;
      animation: sc-fill 8s linear infinite;
      animation-play-state: paused;
    }
  }

  .sc-col[data-on='true'] {
    .sc-layer,
    .sc-car-body,
    .sc-wheel,
    .sc-progress span {
      animation-play-state: running;
    }
  }

  @keyframes sc-scroll {
    to {
      transform: translateX(calc(var(--tile) * -1));
    }
  }

  @keyframes sc-bounce {
    to {
      transform: translateY(#{rem(-0.8)});
    }
  }

  @keyframes sc-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sc-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  // 회의 화면 — 기본은 단서 없음. is-cue 일 때만 상태 표시 노출
  // 참가자 타일 — 왼쪽 큰 타일이 나, 오른쪽 두 타일이 다른 참가자
  .sc-meeting {
    display: grid;
    grid-template-columns: 3fr 2fr;
    grid-template-rows: 1fr 1fr;
    gap: rem(4);
    padding: rem(6);
    background: #d3d9e5;
  }

  .sc-tile {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    border-radius: rem(5);
    background: #eef1f6;

    &--me {
      grid-row: 1 / 3;
    }
  }

  .sc-avatar {
    display: grid;
    place-items: center;
    width: rem(30);
    height: rem(30);
    border-radius: 50%;
    background: #dbe4f3;
    color: #4a5a78;
    font-size: 0.78rem;
    font-weight: 600;

    .sc-tile--me & {
      width: rem(44);
      height: rem(44);
      font-size: inherit;
    }

    &--a {
      background: #f3dfd3;
      color: #8a5335;
    }

    &--b {
      background: #dcecdd;
      color: #3f6b45;
    }
  }

  .sc-cue {
    position: absolute;
    left: rem(6);
    bottom: rem(6);
    display: flex;
    align-items: center;
    gap: rem(5);
    padding: rem(3) rem(8);
    border-radius: 999px;
    background: #fff;
    color: #5b6170;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.5;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease;

    .sc-demo.is-cue & {
      opacity: 1;
      visibility: visible;
    }
  }

  .sc-meter {
    display: flex;
    align-items: center;
    gap: rem(2);
    height: rem(12);

    span {
      width: rem(3);
      height: rem(3);
      border-radius: rem(2);
      background: #b0b4bf;
    }
  }

  .sc-cue-text--on {
    display: none;
  }

  .sc-col[data-on='true'] {
    .sc-cue {
      color: #1e874b;
    }
    .sc-cue-text--on {
      display: block;
    }
    .sc-cue-text--off {
      display: none;
    }
    .sc-meter span {
      height: rem(10);
      background: #1e874b;
      transform: scaleY(0.25);
      animation: sc-level 0.45s ease-in-out infinite alternate;

      &:nth-child(2) {
        animation-delay: 0.1s;
      }
      &:nth-child(3) {
        animation-delay: 0.2s;
      }
    }
  }

  @keyframes sc-level {
    to {
      transform: scaleY(1);
    }
  }

  .sc-bar {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0.6rem;
    border-top: 1px solid #ececf0;
  }

  .sc-btn {
    display: grid;
    place-items: center;
    width: rem(40);
    height: rem(40);
    padding: 0;
    border: 1px solid #cfcfd4;
    border-radius: 50%;
    background: #fff;
    color: #222;
    cursor: pointer;

    &:hover {
      background: #f4f4f6;
    }

    &:focus-visible {
      outline: 2px solid #3b82f6;
      outline-offset: 2px;
    }
  }

  // 아이콘 = 누르면 일어날 일. off 아이콘은 꺼진 상태에서, on 아이콘은 켜진 상태에서 노출
  .sc-icon {
    width: rem(22);
    height: rem(22);

    &--line {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    &--on {
      display: none;
    }
  }

  .sc-col[data-on='true'] {
    .sc-icon--off {
      display: none;
    }
    .sc-icon--on {
      display: block;
    }
  }

  // 상태 표시 옵션에 따라 음소거 열의 배지·설명 교체
  .sc-withcue {
    display: none;
  }

  .sc-demo.is-cue .sc-col[data-kind='mic'] {
    .sc-nocue {
      display: none;
    }
    .sc-withcue {
      display: block;
    }
  }

  .sc-note {
    margin-top: 0.45rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #777;
  }
</style>

<script>
  import './script.js';
</script>
